{
  "name": "tozzo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "PLAYWRIGHT_BROWSERS_PATH=0 ../node_modules/.bin/playwright test -c playwright.visual.config.ts",
    "test:visual:linux": "bash scripts/visual-linux.sh",
    "api:types": "openapi-typescript https://dev-api.tozzo.uk/v1/openapi.yaml -o src/api/schema.d.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "analyze": "ANALYZE=1 vite build",
    "size": "node scripts/measure-initial.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 ../node_modules/.bin/playwright test"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.104.2",
    "@thisbeyond/solid-dnd": "0.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.4.1",
    "lucide-solid": "0.344.0",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.17",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "autoprefixer": "10.5.4",
    "happy-dom": "20.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  }
}
